# agent-example. Placeholders only; the real file is secrets/agent-example.env (mode 600, gitignored).
# Only what THIS agent needs: scoped, spend-capped, revocable, labelled "agent-example".

# Dedicated Console API key (own workspace, spend limit). Never a main key or a claude.ai/Claude Code OAuth token.
ANTHROPIC_API_KEY=<scoped-key-agent-example>   # VERIFY variable name and provider selection in current Hermes docs

# Slack gateway (Socket Mode, outbound only). Check the variable names against current Hermes docs.
# Tokens come from this agent's own Slack app only; rotate on any suspicion. Never paste them into chat or commit them.
SLACK_BOT_TOKEN=<xoxb-token-agent-example>
SLACK_APP_TOKEN=<xapp-token-agent-example>      # app-level token, scope connections:write
SLACK_ALLOWED_USERS=<your-member-id>      # comma-separated Member IDs (e.g. U01ABC2DEF3); unset = deny all
# Leave SLACK_ALLOW_BOTS unset (default none) and never set GATEWAY_ALLOW_ALL_USERS / SLACK_ALLOW_ALL_USERS.
# SLACK_ALLOWED_CHANNELS=<channel-ids>    # optional; DMs are exempt
# Home channel for cron results and proactive messages. Use your DM with the bot (ID starts with D), never a channel.
# SLACK_HOME_CHANNEL=<dm-channel-id>
# SLACK_HOME_CHANNEL_NAME=<label>

# GitHub: the agent's own identity, ONE repository, never a personal or org-wide token. Read-only first: add write
# access only if the agent must push branches and open PRs, and then require human approval on that repository.
# Fine-grained token, resource owner = the account or org, repository = a single repo, for example:
#   Contents: read+write, Pull requests: read+write, Issues: read, Actions: read (CI logs), Metadata: read.
#   NOT granted: Workflows, Actions write, Administration, Secrets, Environments, Webhooks.
# The default branch must have branch protection (required review + checks); the token cannot enforce that.
# The token does NOT go in this file: Hermes strips GITHUB_TOKEN/GH_TOKEN from terminal commands. It lives in
# secrets/agent-example.github_token (value only, owner 10000:10000, mode 0400), mounted read-only at
# /etc/agent/github_token; the gh wrapper reads it and git gets it from gh.
